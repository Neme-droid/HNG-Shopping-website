{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "../lib/products.ts",
    "../lib/checkout-schema.ts",
    "../lib/auth-schema.ts"
  ],
  "exclude": [
    "node_modules",
    "tests"
  ]
}
