# Copy to .env and fill in. These are the SAME values the website uses in ../.env.local,
# just with the EXPO_PUBLIC_ prefix instead of NEXT_PUBLIC_.
# NEVER put SUPABASE_SERVICE_ROLE_KEY (or any other secret) in this app: EXPO_PUBLIC_ values ship inside the app bundle.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
