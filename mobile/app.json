{
  "expo": {
    "name": "TerraVerde",
    "slug": "terraverde-mobile",
    "scheme": "terraverde",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F6F7F1",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#17402A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.terraverde.shop"
    },
    "android": {
      "package": "com.terraverde.shop",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#17402A"
      },
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ]
  }
}
